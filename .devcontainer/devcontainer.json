{
    "name": "OS Kernel 2026 Dev Environment",
    "image": "zhouzhouyi/os-contest:20260104",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.makefile-tools",
                "rust-lang.rust-analyzer",      // Rust 语言支持（包含 rustfmt 调用）
                "vadimcn.vscode-lldb",          // CodeLLDB – 调试器
                "fill-labs.dependi",            // Dependi – 依赖管理增强
                "tamasfe.even-better-toml"      // Even Better TOML – Cargo.toml 语法高亮/验证
            ]
        }
    }
}